{
"compilerOptions": {
"target": "ES2020",
"useDefineForClassFields": true,
"lib": ["ES2020", "DOM", "DOM.Iterable"],
"module": "ESNext",
"skipLibCheck": true,
"jsx": "react-jsx",
"moduleResolution": "bundler",
"resolveJsonModule": true,
"isolatedModules": true,
"noEmit": true,
"strict": true,
"noFallthroughCasesInSwitch": true,
"baseUrl": ".",
"paths": {
"@/components/*": ["src/components/*"],
"@/pages/*": ["src/pages/*"],
"@/services/*": ["src/services/*"],
"@/types/*": ["src/types/*"]
}
},
"include": ["src"]
}